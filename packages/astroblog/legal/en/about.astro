---
// Template: about (en). Author card, the site description as bio and social links.
import routes from 'virtual:astroblog/routes';
import { withBase } from '../../lib/routes';
import AuthorCard from '../AuthorCard.astro';
import type { LegalTemplateProps } from '../types';

export type Props = LegalTemplateProps;

const { config } = Astro.props;
const base = import.meta.env.BASE_URL;
const social = Object.entries(config.social ?? {});
const contactHref = routes.paths.contact ? withBase(base, routes.paths.contact) : undefined;
---
<div data-about-template>
  <AuthorCard config={config} />

  <p><strong>{config.title}</strong>{config.author ? <> is a blog written by {config.author.name}.</> : '.'} {config.description}</p>

  {social.length > 0 && (
    <section>
      <p>You can also find us on:</p>
      <ul>
        {social.map(([network, url]) => <li><a href={url} rel="me noopener">{network}</a></li>)}
      </ul>
    </section>
  )}

  {contactHref && <p>Want to tell us something? Visit the <a href={contactHref}>contact page</a>.</p>}
</div>
