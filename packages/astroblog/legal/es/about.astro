---
// Plantilla: acerca de (es). Ficha del autor, descripción del sitio como bio y redes sociales.
import routes from 'virtual:astroblog/routes';
import { withBase } from '../../lib/routes';
import AuthorCard from '../AuthorCard.astro';
import type { LegalTemplateProps } from '../types';

export type Props = LegalTemplateProps;

const { config } = Astro.props;
const base = import.meta.env.BASE_URL;
const social = Object.entries(config.social ?? {});
const contactHref = routes.paths.contact ? withBase(base, routes.paths.contact) : undefined;
---
<div data-about-template>
  <AuthorCard config={config} />

  <p><strong>{config.title}</strong>{config.author ? <> es un blog escrito por {config.author.name}.</> : '.'} {config.description}</p>

  {social.length > 0 && (
    <section>
      <p>Encuéntranos también en:</p>
      <ul>
        {social.map(([network, url]) => <li><a href={url} rel="me noopener">{network}</a></li>)}
      </ul>
    </section>
  )}

  {contactHref && <p>¿Quieres decirnos algo? Visita la <a href={contactHref}>página de contacto</a>.</p>}
</div>
