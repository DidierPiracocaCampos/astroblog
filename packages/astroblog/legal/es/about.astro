---
// Plantilla: acerca de (es). Autor (avatar, nombre), descripción del sitio como bio y redes sociales.
import routes from 'virtual:astroblog/routes';
import { withBase } from '../../lib/routes';
import type { LegalTemplateProps } from '../types';

export type Props = LegalTemplateProps;

const { config } = Astro.props;
const base = import.meta.env.BASE_URL;
const author = config.author;
const name = author?.name ?? config.owner?.name ?? config.title;
const avatar = author?.avatar ? withBase(base, author.avatar) : undefined;
const initial = [...name.trim()][0]?.toUpperCase() ?? '';
const social = Object.entries(config.social ?? {});
const contactHref = routes.paths.contact ? withBase(base, routes.paths.contact) : undefined;
---
<div data-about-template>
  <div class="not-prose my-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
    {avatar ? (
      <div class="avatar">
        <div class="w-24 rounded-full">
          <img src={avatar} alt="" width="96" height="96" />
        </div>
      </div>
    ) : (
      <div class="avatar avatar-placeholder">
        <div class="bg-neutral text-neutral-content w-24 rounded-full">
          <span class="text-3xl" aria-hidden="true">{initial}</span>
        </div>
      </div>
    )}
    <div class="flex flex-col gap-1">
      <span class="text-xl font-semibold">{name}</span>
      {author?.url && <a href={author.url} class="link link-primary text-sm" rel="author noopener">{author.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>}
    </div>
  </div>

  <p><strong>{config.title}</strong>{author ? <> es un blog escrito por {author.name}.</> : '.'} {config.description}</p>

  {social.length > 0 && (
    <section>
      <p>Encuéntranos también en:</p>
      <ul>
        {social.map(([network, url]) => <li><a href={url} rel="me noopener">{network}</a></li>)}
      </ul>
    </section>
  )}

  {contactHref && <p>¿Quieres decirnos algo? Visita la <a href={contactHref}>página de contacto</a>.</p>}
</div>
