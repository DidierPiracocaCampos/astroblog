---
// Overridable: `components.AuthorBox`. Author card: daisyUI `avatar` (image or initial), name linked
// to the author page and, when known, the author's own website.
import ui from 'virtual:astroblog/ui';
import { withBase } from '../lib/routes';

export interface Props {
  name: string;
  /** Author page (already prefixed with `base`). */
  href?: string;
  /** External profile/website (`author.url`). */
  url?: string;
  /** Avatar image: absolute URL or a path relative to `base` (e.g. in `public/`). */
  avatar?: string;
  /** `author.jobTitle` and `author.bio`, shown under the name when set. */
  jobTitle?: string;
  bio?: string;
}

const { name, href, url, avatar, jobTitle, bio } = Astro.props;
const src = avatar ? withBase(import.meta.env.BASE_URL, avatar) : undefined;
const initial = [...name.trim()][0]?.toUpperCase() ?? '';
---
<section class="card card-border bg-base-200 mt-10" aria-label={ui.author} data-pagefind-ignore>
  <div class="card-body flex-row items-center gap-4">
    {src ? (
      <div class="avatar">
        <div class="w-16 rounded-full">
          <img src={src} alt="" width="64" height="64" loading="lazy" />
        </div>
      </div>
    ) : (
      <div class="avatar avatar-placeholder">
        <div class="bg-neutral text-neutral-content w-16 rounded-full">
          <span class="text-2xl" aria-hidden="true">{initial}</span>
        </div>
      </div>
    )}
    <div class="flex flex-col gap-1">
      <span class="text-xs uppercase tracking-wide text-base-content/70">{ui.author}</span>
      {href ? <a href={href} class="link link-hover text-lg font-semibold">{name}</a> : <span class="text-lg font-semibold">{name}</span>}
      {jobTitle && <span class="text-sm text-base-content/70">{jobTitle}</span>}
      {bio && <p class="text-sm text-base-content/80">{bio}</p>}
      {url && <a href={url} class="link link-primary text-sm" rel="author noopener" target="_blank">{url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>}
    </div>
  </div>
</section>
