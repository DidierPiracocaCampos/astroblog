---
// Overridable: `components.Sources`. The post's `sources`: external links (nofollow, new tab).
import ui from 'virtual:astroblog/ui';

export interface Props {
  items: { title: string; url: string }[];
}

const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-10" aria-labelledby="sources-title">
    <h2 id="sources-title" class="mb-3 text-xl font-bold">{ui.sourcesTitle}</h2>
    <ol class="list-decimal space-y-1 pl-6">
      {items.map(({ title, url }) => (
        <li><a href={url} class="link link-primary" rel="nofollow noopener" target="_blank">{title}</a></li>
      ))}
    </ol>
  </section>
)}
