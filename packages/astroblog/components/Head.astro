---
// System component (not overridable). Emits <head> contents in the order of spec §6:
// meta → OG/Twitter/JSON-LD → theme script → consent default → CMP → AdSense → GA4.
// The global CSS link is appended by Astro after this content (imported in BaseLayout).
import config from 'virtual:astroblog/config';
import { absoluteImage, absoluteUrl, buildMeta } from '../lib/seo';
import { adsenseScript, ga4Scripts } from '../lib/consent';
import { stripBase } from '../lib/routes';
import { themeScript } from '../lib/theme';
import ConsentManager from './ConsentManager.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: object[];
}

const { title, description, image, type = 'website', publishedTime, modifiedTime, jsonLd = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href;
// Without `site` there is no absolute URL: canonical and og:url are omitted.
const canonical = site ? absoluteUrl(site, base, stripBase(base, Astro.url.pathname)) : undefined;
// Relative images need `site` too: without it og:image/twitter:image are omitted.
const absImage = absoluteImage(site, base, image);

const { title: fullTitle, meta } = buildMeta({
  title,
  siteTitle: config.title,
  description,
  url: canonical ?? '',
  image: absImage,
  type,
  lang: config.lang,
  publishedTime,
  modifiedTime,
});
const social = meta.filter((m) => m.name !== 'description' && !(m.property === 'og:url' && !canonical));

// JSON inside <script>: escape `<` so the content cannot close the tag.
const ldJson = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{social.map((m) => (m.property ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))}
{jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={ldJson(data)} />)}
<script is:inline set:html={themeScript(config.theme)} />
<ConsentManager />
{config.adsense && <Fragment set:html={adsenseScript(config.adsense.client)} />}
{config.analytics?.ga4 && <Fragment set:html={ga4Scripts(config.analytics.ga4)} />}
