---
// Overridable: `components.Footer`. Institutional/legal links (only active routes),
// cookie settings, copyright and social links.
import config from 'virtual:astroblog/config';
import ui from 'virtual:astroblog/ui';
import routes from 'virtual:astroblog/routes';
import { t } from '../i18n/index';
import { withBase } from '../lib/routes';
import { hasCmp } from '../lib/consent';
import CookieSettingsLink from './CookieSettingsLink.astro';

const base = import.meta.env.BASE_URL;
const PAGE_KEYS = ['about', 'contact', 'privacy', 'cookies', 'terms', 'legal'] as const;
const pages = PAGE_KEYS.flatMap((key) => {
  const path = routes.paths[key];
  return path ? [{ label: ui[key], href: withBase(base, path) }] : [];
});
const social = Object.entries(config.social ?? {});
const owner = config.owner?.name ?? config.author?.name ?? config.title;
const copyright = t(ui.copyright, { year: new Date().getFullYear(), name: owner });
---
<footer class="bg-base-200 text-base-content mt-12">
  <div class="footer sm:footer-horizontal mx-auto max-w-6xl p-10">
    <nav aria-label={ui.legal}>
      <ul class="flex flex-col gap-2">
        {pages.map((p) => <li><a class="link link-hover" href={p.href}>{p.label}</a></li>)}
        {hasCmp(config) && <li><CookieSettingsLink class="link-hover" /></li>}
      </ul>
    </nav>
    {social.length > 0 && (
      <nav>
        <ul class="flex flex-wrap gap-4">
          {social.map(([name, url]) => <li><a class="link link-hover" href={url} rel="me noopener" target="_blank">{name}</a></li>)}
        </ul>
      </nav>
    )}
  </div>
  <div class="footer footer-center border-t border-base-300 p-4">
    <p>{copyright}</p>
  </div>
</footer>
