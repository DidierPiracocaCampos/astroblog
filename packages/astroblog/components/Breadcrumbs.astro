---
// Overridable: `components.Breadcrumbs`. daisyUI `breadcrumbs`; the last item is the current page.
import ui from 'virtual:astroblog/ui';
import { withBase } from '../lib/routes';

export interface Props {
  /** `href` is relative to `base` (e.g. '/categoria/diseno'), like the `virtual:astroblog/routes` paths. */
  items: { name: string; href: string }[];
}

const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{items.length > 0 && (
  <nav class="breadcrumbs text-sm" aria-label={ui.breadcrumbs}>
    <ul>
      {items.map((item, i) =>
        i === items.length - 1
          ? <li><span aria-current="page">{item.name}</span></li>
          : <li><a href={withBase(base, item.href)}>{item.name}</a></li>,
      )}
    </ul>
  </nav>
)}
