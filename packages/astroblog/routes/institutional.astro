---
// Institutional/legal pages (about, contact, privacy, cookies, terms, legal): one entry injected for
// the six static patterns. The route key comes from matching the pathname against
// `virtual:astroblog/routes`. Renders the user's `pages` entry whose id is the route slug
// (`src/content/pages/privacidad.md`) when it exists, else the `legal/<lang>/<key>.astro` template.
import { render } from 'astro:content';
import config from 'virtual:astroblog/config';
import ui from 'virtual:astroblog/ui';
import routes from 'virtual:astroblog/routes';
import PageLayout from '../layouts/PageLayout.astro';
import Updated from '../legal/Updated.astro';
import EsAbout from '../legal/es/about.astro';
import EsContact from '../legal/es/contact.astro';
import EsPrivacy from '../legal/es/privacy.astro';
import EsCookies from '../legal/es/cookies.astro';
import EsTerms from '../legal/es/terms.astro';
import EsLegal from '../legal/es/legal.astro';
import EnAbout from '../legal/en/about.astro';
import EnContact from '../legal/en/contact.astro';
import EnPrivacy from '../legal/en/privacy.astro';
import EnCookies from '../legal/en/cookies.astro';
import EnTerms from '../legal/en/terms.astro';
import EnLegal from '../legal/en/legal.astro';
import { findPage } from '../lib/blog';
import { institutionalKey, pageEntryId } from '../lib/legal';
import { stripBase } from '../lib/routes';

const TEMPLATES = {
  es: { about: EsAbout, contact: EsContact, privacy: EsPrivacy, cookies: EsCookies, terms: EsTerms, legal: EsLegal },
  en: { about: EnAbout, contact: EnContact, privacy: EnPrivacy, cookies: EnCookies, terms: EnTerms, legal: EnLegal },
};

// Ruling: the "last updated" date of the templates is the build date.
const BUILD_DATE = new Date();

const key = institutionalKey(routes.paths, stripBase(import.meta.env.BASE_URL, Astro.url.pathname));
if (!key) throw new Error(`[astroblog] no institutional route matches ${Astro.url.pathname}`);
const path = routes.paths[key]!;
const entry = await findPage(pageEntryId(path));
const Content = entry ? (await render(entry)).Content : undefined;
const Template = TEMPLATES[config.lang][key];

const title = entry?.data.title ?? ui[key];
const description = entry?.data.description ?? `${ui[key]} · ${config.title}`;
const updatedDate = entry?.data.updatedDate;
---
<PageLayout title={title} description={description} breadcrumbs={[{ name: ui.home, href: '/' }, { name: title, href: path }]}>
  {Content ? (
    <>
      {updatedDate && <Updated date={updatedDate} />}
      <Content />
    </>
  ) : (
    <Template config={config} updated={BUILD_DATE} />
  )}
</PageLayout>
