---
// Home: page 1 of the post listing (pages 2..n are page.astro). Empty state when there are no posts.
import config from 'virtual:astroblog/config';
import ListLayout from '../layouts/ListLayout.astro';
import { loadPosts } from '../lib/blog';
import { homePagesPrefix, paginationPaths, withBase } from '../lib/routes';

const base = import.meta.env.BASE_URL;
const posts = await loadPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / config.postsPerPage));
const urls = paginationPaths('/', homePagesPrefix(config), lastPage).map((p) => withBase(base, p));
---
<ListLayout
  title={config.title}
  description={config.description}
  heading={config.title}
  posts={posts.slice(0, config.postsPerPage)}
  currentPage={1}
  urls={urls}
/>
