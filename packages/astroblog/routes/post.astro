---
// Post page (`/blog/[...slug]`). Drafts are only built in `astro dev`. Emits SEO length warnings
// (title > 70, description outside 50–160) once per post, when the paths are computed.
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { postEntries } from '../lib/blog';

export async function getStaticPaths() {
  return (await postEntries()).map((props) => ({ params: { slug: props.post.id }, props }));
}

const { post, related } = Astro.props as { post: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[] };
const { Content, headings } = await render(post);
---
<PostLayout post={post} headings={headings} related={related}>
  <Content />
</PostLayout>
