---
// Author page (`/autor/[author]`): every post of the author (slug = slugify(author); posts without
// `author` count as the site's `author.name`). Uses `config.author` as the profile when it matches.
import type { CollectionEntry } from 'astro:content';
import config from 'virtual:astroblog/config';
import ui from 'virtual:astroblog/ui';
import routes from 'virtual:astroblog/routes';
import { AuthorBox } from 'virtual:astroblog/components';
import ListLayout from '../layouts/ListLayout.astro';
import { authorGroups } from '../lib/blog';
import { slugify } from '../lib/posts';
import { taxonomyPath } from '../lib/routes';

export async function getStaticPaths() {
  const groups = await authorGroups(config.author?.name);
  return [...groups].map(([author, g]) => ({ params: { author }, props: { label: g.label, posts: g.posts } }));
}

const { label, posts } = Astro.props as { label: string; posts: CollectionEntry<'blog'>[] };
const profile = config.author && slugify(config.author.name) === Astro.params.author ? config.author : undefined;
const path = taxonomyPath(routes.paths, 'author', label)!; // the route exists: it is rendering this page
---
<ListLayout
  title={label}
  description={`${ui.author}: ${label}`}
  breadcrumbs={[{ name: ui.home, href: '/' }, { name: label, href: path }]}
  heading={label}
  posts={posts}
>
  <div slot="intro" class="mb-8">
    <AuthorBox name={profile?.name ?? label} url={profile?.url} avatar={profile?.avatar} />
  </div>
</ListLayout>
