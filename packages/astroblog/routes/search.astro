---
// Search page (`/buscar`), only injected when `search` is on: a fallback to the search modal.
// Without JS the form submits `?q=` to this same page; with JS, Pagefind's default UI (loaded from
// `<base>pagefind/`) replaces the form and runs the `q` query on load.
import ui from 'virtual:astroblog/ui';
import routes from 'virtual:astroblog/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/routes';

const base = import.meta.env.BASE_URL;
const action = withBase(base, routes.paths.search ?? '/');
const bundle = withBase(base, 'pagefind/');
---
<BaseLayout title={ui.search} description={ui.searchPlaceholder}>
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-8 text-3xl font-bold sm:text-4xl">{ui.search}</h1>
    <form id="astroblog-search-form" role="search" action={action} method="get" class="join w-full">
      <input type="search" name="q" class="input join-item w-full" placeholder={ui.searchPlaceholder} aria-label={ui.search} />
      <button type="submit" class="btn btn-primary join-item">{ui.search}</button>
    </form>
    <div id="astroblog-search-page" data-bundle={bundle} data-placeholder={ui.searchPlaceholder}></div>
  </div>
</BaseLayout>

<script>
  import { mountPagefindUI } from '../lib/pagefind-client';

  const host = document.getElementById('astroblog-search-page');
  const form = document.getElementById('astroblog-search-form');
  if (host && form) {
    const { bundle = '/pagefind/', placeholder } = host.dataset;
    mountPagefindUI({ element: '#astroblog-search-page', bundle, placeholder })
      .then((pagefind) => {
        form.hidden = true;
        const q = new URLSearchParams(location.search).get('q')?.trim();
        if (q) pagefind.triggerSearch(q);
        host.querySelector<HTMLInputElement>('input')?.focus();
      })
      .catch((e) => console.error(e)); // the plain form stays usable
  }
</script>
