---
// Tag listing (`/etiqueta/[tag]/[...page]`): page 1 at `/etiqueta/x`, page n at `/etiqueta/x/n`.
// Slug from `slugify`, title from the original label; no page for tags without posts.
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import config from 'virtual:astroblog/config';
import ui from 'virtual:astroblog/ui';
import routes from 'virtual:astroblog/routes';
import ListLayout from '../layouts/ListLayout.astro';
import { groupByTaxonomy, publishedPosts } from '../lib/posts';
import { paginationPaths, withBase } from '../lib/routes';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = publishedPosts(await getCollection('blog'), { includeDrafts: import.meta.env.DEV });
  const groups = groupByTaxonomy(posts, 'tags', (m) => console.warn(`[astroblog] ${m}`));
  return [...groups].flatMap(([tag, g]) =>
    paginate(g.posts, { params: { tag }, props: { label: g.label }, pageSize: config.postsPerPage }));
}

const { page, label } = Astro.props as { page: Page<CollectionEntry<'blog'>>; label: string };
const base = import.meta.env.BASE_URL;
const path = `${routes.paths.tag}/${Astro.params.tag}`;
const urls = paginationPaths(path, path, page.lastPage).map((p) => withBase(base, p));
const n = page.currentPage;
const title = n > 1 ? `${label} — ${ui.page} ${n}` : label;
const breadcrumbs = [
  { name: ui.home, href: '/' },
  { name: label, href: path },
  ...(n > 1 ? [{ name: `${ui.page} ${n}`, href: `${path}/${n}` }] : []),
];
---
<ListLayout
  title={title}
  description={`${ui.tags}: ${label}`}
  breadcrumbs={breadcrumbs}
  heading={label}
  posts={page.data}
  currentPage={n}
  urls={urls}
/>
