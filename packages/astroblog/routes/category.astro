---
// Category listing (`/categoria/[cat]/[...page]`): page 1 at `/categoria/x/`, page n at `/categoria/x/n/`.
// Slug from `slugify`, title from the original label; no page for categories without posts.
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import config from 'virtual:astroblog/config';
import TaxonomyLayout from '../layouts/TaxonomyLayout.astro';
import { taxonomyStaticPaths } from '../lib/blog';

export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return taxonomyStaticPaths('category', 'cat', paginate, config.postsPerPage);
}

const { page, label } = Astro.props as { page: Page<CollectionEntry<'blog'>>; label: string };
---
<TaxonomyLayout kind="category" label={label} page={page} />
