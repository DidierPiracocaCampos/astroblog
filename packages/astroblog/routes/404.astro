---
// Not-found page (`/404`, built as 404.html): message, link home and the latest 3 posts.
// Not indexable: noindex and no canonical (the sitemap integration also skips it).
import ui from 'virtual:astroblog/ui';
import { PostCard } from 'virtual:astroblog/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPosts } from '../lib/blog';
import { withBase } from '../lib/routes';

const posts = (await loadPosts()).slice(0, 3);
const home = withBase(import.meta.env.BASE_URL, '/');
---
<BaseLayout title={ui.notFoundTitle} description={ui.notFoundBody} noindex>
  <section class="hero py-12">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <p class="text-base-content/60 text-6xl font-bold" aria-hidden="true">404</p>
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{ui.notFoundTitle}</h1>
        <p class="py-6 text-base-content/80">{ui.notFoundBody}</p>
        <a href={home} class="btn btn-primary">{ui.backHome}</a>
      </div>
    </div>
  </section>
  {posts.length > 0 && (
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  )}
</BaseLayout>
