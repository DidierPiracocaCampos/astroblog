---
// Post page: BaseLayout (article meta, BlogPosting + BreadcrumbList JSON-LD) with the post header and
// content inside the pagefind-indexed <article>, then the afterPost ad, share links, author box and
// related posts. The table of contents (h2–h3, at least 3) goes in the aside.
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import config from 'virtual:astroblog/config';
import ui from 'virtual:astroblog/ui';
import routes from 'virtual:astroblog/routes';
import { AuthorBox, Comments, PostHeader, RelatedPosts, ShareLinks, TableOfContents } from 'virtual:astroblog/components';
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { authorOf, slugify } from '../lib/posts';
import { routePath, stripBase, taxonomyPath, withBase } from '../lib/routes';
import { absoluteImage, absoluteUrl, jsonLdPost } from '../lib/seo';

export interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  related: CollectionEntry<'blog'>[];
}

const { post, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, cover, category, noAds } = post.data;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href;
const url = site ? absoluteUrl(site, base, stripBase(base, Astro.url.pathname)) : undefined;
// `cover.src` already carries `base`; BaseLayout/Head resolve images relative to it.
const image = cover ? stripBase(base, cover.src) : undefined;

const author = authorOf(post, config.author?.name);
const authorPath = author ? taxonomyPath(routes.paths, 'author', author) : undefined;
const profile = author && config.author && slugify(config.author.name) === slugify(author) ? config.author : undefined;

const categoryPath = taxonomyPath(routes.paths, 'category', category);
const breadcrumbs = [
  { name: ui.home, href: '/' },
  ...(categoryPath ? [{ name: category, href: categoryPath }] : []),
  { name: title, href: routePath(config, 'post', post.id) },
];

const jsonLd = site && url
  ? [jsonLdPost({
      title,
      description,
      url,
      image: absoluteImage(site, base, image),
      datePublished: pubDate,
      dateModified: updatedDate,
      author: {
        name: author ?? config.owner?.name ?? config.title,
        url: authorPath ? absoluteUrl(site, base, authorPath) : profile?.url,
      },
      publisherName: config.owner?.name ?? config.author?.name ?? config.title,
    })]
  : [];

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl" data-pagefind-body>
    <PostHeader post={post} />
    <div class="prose max-w-none">
      <slot />
    </div>
  </article>
  <div class="mx-auto max-w-3xl">
    {!noAds && <AdSlot slot={config.adsense?.slots?.afterPost} />}
    {url && <ShareLinks url={url} title={title} />}
    {author && (
      <AuthorBox
        name={author}
        href={authorPath ? withBase(base, authorPath) : undefined}
        url={profile?.url}
        avatar={profile?.avatar}
      />
    )}
  </div>
  {config.comments?.giscus && <div class="mx-auto max-w-3xl"><Comments /></div>}
  <RelatedPosts posts={related} />
  {toc.length >= 3 && <TableOfContents slot="aside" headings={toc} />}
</BaseLayout>
