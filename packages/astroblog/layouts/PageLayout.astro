---
// Simple content page (institutional pages, etc.): BaseLayout + a `prose` article with the title as <h1>.
// The `aside` slot is only forwarded when given: a conditionally forwarded slot would still count as
// present in BaseLayout and render an empty sidebar column.
import BaseLayout from './BaseLayout.astro';
import type { Props as BaseProps } from './BaseLayout.astro';

export type Props = BaseProps;

const props = Astro.props;
const hasAside = Astro.slots.has('aside');
---
{hasAside ? (
  <BaseLayout {...props}>
    <article class="prose mx-auto max-w-3xl">
      <h1>{props.title}</h1>
      <slot />
    </article>
    <slot name="aside" slot="aside" />
  </BaseLayout>
) : (
  <BaseLayout {...props}>
    <article class="prose mx-auto max-w-3xl">
      <h1>{props.title}</h1>
      <slot />
    </article>
  </BaseLayout>
)}
