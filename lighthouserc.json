{
  "ci": {
    "collect": {
      "staticDistDir": "examples/demo/dist",
      "url": [
        "http://localhost/",
        "http://localhost/blog/guia-core-web-vitals/",
        "http://localhost/categoria/diseno/",
        "http://localhost/acerca/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
